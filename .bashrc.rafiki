# .bashrc

# Source global definitions
if [ -f /etc/bashrc ]; then
	. /etc/bashrc
fi

# don't put duplicate lines or lines starting with space in the history.
# See bash(1) for more options
HISTCONTROL=ignoreboth
# append to the history file, don't overwrite it
shopt -s histappend
# Add time stamp
export HISTTIMEFORMAT="%d/%m/%y %T "
# check the window size after each command and, if necessary,
# update the values of LINES and COLUMNS.
shopt -s checkwinsize
export HISTSIZE=1000000
export GTK_THEME=Adwaita:dark

# User specific environment
if ! [[ "$PATH" =~ "$HOME/.local/bin:$HOME/bin:" ]]
then
    PATH="$HOME/.local/bin:$HOME/bin:$PATH"
fi
export PATH

# prompt
eval "$(starship init bash)"

# Aliases
[ -f ~/.aliases ] && source ~/.aliases
[ -f ~/.fzf.bash ] && source ~/.fzf.bash

# Activate spack
alias activate_spack='source ${HOME}/lib/spack/share/spack/setup-env.sh'

# fix routing
alias vpnroutingfix='sudo ip route add 10.148.48.0/24 via 129.132.112.193 dev enp5s0f0'
alias vpnroutingreset='sudo ip route del 10.148.48.0/24'

start_ssh_agent() {
    eval "$(ssh-agent -s)"
    ssh-add ~/.ssh/id_ed25519
}

if (( EUID != 0 )); then
    _agent_link=${HOME}/.ssh/ssh_auth_sock
    _op_sock=${HOME}/.1password/agent.sock
    if [[ -n ${TMUX} ]]; then
        [[ -S ${_agent_link} ]] || ln -sfn "${_op_sock}" "${_agent_link}"
        export SSH_AUTH_SOCK=${_agent_link}
    elif [[ -n ${SSH_CONNECTION} ]]; then
        [[ -S ${SSH_AUTH_SOCK} && ${SSH_AUTH_SOCK} != "${_agent_link}" ]] && \
            ln -sfn "${SSH_AUTH_SOCK}" "${_agent_link}"
    else
        ln -sfn "${_op_sock}" "${_agent_link}"
        export SSH_AUTH_SOCK=${_op_sock}
    fi
    unset _agent_link _op_sock
    ## sign commits via $SSH_AUTH_SOCK; op-ssh-sign talks to the local 1password
    ## app directly, so inside tmux over ssh it prompts on the desk screen
    #export GIT_CONFIG_COUNT=1
    #export GIT_CONFIG_KEY_0=gpg.ssh.program
    #export GIT_CONFIG_VALUE_0=ssh-keygen
fi

# kitty
export PATH="${HOME}/.local/kitty.app/bin:${PATH}"

# golang
export GOPATH="${HOME}/lib/golang/go-latest"
export PATH="${GOPATH}/bin:${PATH}"

# rust
. "$HOME/.cargo/env"

# xrandr --output "DP-5" --mode "1920x1200" --left-of "DP-2"

# nvm / node
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH=$BUN_INSTALL/bin:$PATH

# Terraform, aws
if command -v awsmyid 2>&1 > /dev/null; then
    complete -C $(which terraform) terraform
    . <(awsmyid completion)
fi

# terragrunt
complete -C terragrunt terragrunt

# tv
eval "$(tv init bash)"

# launch
export LAUNCH_HOME="$HOME/.launch"
export PATH="$LAUNCH_HOME/bin:$PATH"
# launch completions
[ -s "$LAUNCH_HOME/complete/launch.bash" ] && source "$LAUNCH_HOME/complete/launch.bash"

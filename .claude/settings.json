{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "WebFetch",
      "WebSearch",
    ],
    "deny": [
      "Bash(git add:*)",
      "Bash(git am:*)",
      "Bash(git apply:*)",
      "Bash(git branch -D:*)",
      "Bash(git branch -M:*)",
      "Bash(git branch -d:*)",
      "Bash(git branch -f:*)",
      "Bash(git branch -m:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git checkout:*)",
      "Bash(git clean:*)",
      "Bash(git commit:*)",
      "Bash(git filter-branch:*)",
      "Bash(git merge:*)",
      "Bash(git mv:*)",
      "Bash(git pull:*)",
      "Bash(git push:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(git restore:*)",
      "Bash(git revert:*)",
      "Bash(git rm:*)",
      "Bash(git stash:*)",
      "Bash(git submodule update:*)",
      "Bash(git switch:*)",
      "Bash(git tag -d:*)",
      "Bash(git update-ref:*)",
      "Bash(git worktree add:*)",
      "Bash(git worktree remove:*)"
    ],
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable"
  },
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowLocalBinding": true
    },
    "filesystem": {
      "allowWrite": [
        "/tmp/build"
      ]
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "showThinkingSummaries": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "editorMode": "vim",
  "autoCompactEnabled": true,
  "switchModelsOnFlag": false,
  "remoteControlAtStartup": false,
  "voiceEnabled": false,
  "model": "opus[1m]"
}

# set primary Rosé Pine colorscheme colors
# themes/catppuccin-mocha
#rosewater #f5e0dc
#flamingo #f2cdcd
#pink #f5c2e7
#mauve #cba6f7
#red #f38ba8
#maroon #eba0ac
#peach #fab387
#yellow #f9e2af
#green #a6e3a1
#teal #94e2d5
#sky #89dceb
#sapphire #74c7ec
#blue #89b4fa
#lavender #b4befe
#text #cdd6f4
#subtext1 #bac2de
#subtext0 #a6adc8
#overlay2 #9399b2
#overlay1 #7f849c
#overlay0 #6c7086
#surface2 #585b70
#surface1 #45475a
#surface0 #313244
#base #1e1e2e
#mantle #181825
#crust #11111b

general {
  output_format = "i3bar"
  color_good = "#a6e3a1"
  color_bad = "#f38ba8"
  color_degraded = "#74c7ec"
  colors = false
  interval = 2
  markup = "pango"
}

order += "volume master"
order += "tztime localdate"
order += "tztime localtime"

volume master {
  format = "<span foreground='#cba6f7' size='large'>  </span><span weight='bold' foreground='#cba6f7'> %volume </span>"
  format_muted = "<span foreground='#eba0ac' size='large'>  </span>"
  device = "default"
  mixer = "Master"
  mixer_idx = 0
  separator_block_width = 2
  separator = true
}

tztime localdate {
  format = "<span weight='bold' foreground='#cba6f7'> %a %d %B </span>"
  separator_block_width = 2
  separator = true
}

tztime localtime {
  format = "<span weight='bold' foreground='#cba6f7'> %H:%M </span>"
  separator_block_width = 2
  separator = false
}
